DB_HOST=localhost
DB_PORT=5432
DB_USER=roadrunner
DB_PASSWORD=your-password-here
DB_NAME=roadrunner

JWT_SECRET=randomly-generated-secret-key

# Generate these manually in Google Cloud Console before Google sign-in will work.

GOOGLE_CLIENT_ID=generated-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=generated-client-secret

GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Generate at mapbox.com (free tier) — used for geocoding delivery addresses
# and driving distance/time (Directions API).

MAPBOX_API_KEY=mapbox-generated-api-key
# Generate at openweathermap.org (free tier) — used to flag delay risk on
# an order's ETA.
OPENWEATHER_API_KEY=openweathermap-generated-api-key

